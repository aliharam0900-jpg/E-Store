# Supabase Configuration
# Replace with your project URL and public anon key from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role (Secret Key)
# Required for background tasks, webhooks, and administrative operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Stripe Payment Gateway Configuration
# Obtain from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"

# Stripe Webhook Secret
# Obtain by running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Site URL for checkout callbacks (defaults to localhost:3000 in development)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend Transactional Email API Key
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
